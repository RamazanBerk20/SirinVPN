[Unit]
Description=SirinVPN automatic reconnect supervisor
Wants=systemd-resolved.service
After=sirinvpn-killswitch.service network.target systemd-resolved.service
ConditionPathExists=/var/lib/sirinvpn/desired-connection.json

[Service]
Type=simple
ExecStart=/usr/lib/sirinvpn/sirinvpn-helper supervise
Restart=on-failure
RestartSec=5s
User=root
Group=root
RuntimeDirectory=sirinvpn
RuntimeDirectoryMode=0755
RuntimeDirectoryPreserve=yes
UMask=0077
CapabilityBoundingSet=CAP_NET_ADMIN CAP_NET_RAW
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
ProtectControlGroups=yes
ProtectKernelLogs=yes
ProtectKernelTunables=yes
ProtectClock=yes
ProtectHostname=yes
PrivateTmp=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6 AF_NETLINK
ReadWritePaths=/run/sirinvpn
# Recovery saves verified endpoint changes and the current connection policy.
ReadWritePaths=/var/lib/sirinvpn
# Only the VPN link's forwarding flag is changed by the helper. Interface
# directories appear after service startup, so bind the network configuration roots.
ReadWritePaths=/proc/sys/net/ipv4/conf /proc/sys/net/ipv6/conf
StandardOutput=null
StandardError=null

[Install]
WantedBy=multi-user.target
