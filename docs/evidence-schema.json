{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "SirinVPN local verification evidence v1",
  "type": "object",
  "required": [
    "schema_version",
    "suite",
    "source",
    "command",
    "platform",
    "architecture",
    "fixture",
    "started",
    "ended",
    "elapsed_seconds",
    "result",
    "exit_code",
    "limitations",
    "artifacts",
    "toolchains",
    "source_changed_during_run"
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "suite": {
      "type": "string",
      "minLength": 1
    },
    "result": {
      "enum": [
        "passed",
        "failed",
        "skipped",
        "blocked",
        "not-run"
      ]
    },
    "source": {
      "type": "object",
      "required": [
        "commit",
        "tree",
        "dirty",
        "source_sha256"
      ],
      "properties": {
        "commit": {
          "type": "string",
          "pattern": "^[0-9a-f]{40}$"
        },
        "tree": {
          "type": "string",
          "pattern": "^[0-9a-f]{40}$"
        },
        "dirty": {
          "type": "boolean"
        },
        "source_sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "verification_source_sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$",
          "description": "Same inventory as source_sha256, excluding only docs/remediation.md (the human result ledger)."
        }
      }
    },
    "command": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string"
      }
    },
    "artifacts": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "filename",
          "size",
          "sha256",
          "signing_category"
        ],
        "properties": {
          "filename": {
            "type": "string",
            "minLength": 1
          },
          "size": {
            "type": "integer",
            "minimum": 0
          },
          "sha256": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          },
          "signing_category": {
            "type": "string",
            "minLength": 1
          },
          "role": {
            "enum": [
              "build-output",
              "tested-input"
            ]
          }
        }
      }
    },
    "limitations": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string"
      }
    },
    "exit_code": {
      "type": "integer"
    },
    "source_changed_during_run": {
      "type": "boolean"
    },
    "platform": {
      "type": "string",
      "minLength": 1
    },
    "architecture": {
      "type": "string",
      "minLength": 1
    },
    "fixture": {
      "type": "string",
      "minLength": 1
    },
    "started": {
      "type": "string",
      "minLength": 1
    },
    "ended": {
      "type": "string",
      "minLength": 1
    },
    "elapsed_seconds": {
      "type": "number",
      "minimum": 0
    },
    "toolchains": {
      "type": "object"
    },
    "tested_artifacts_before": {
      "$ref": "#/properties/artifacts"
    },
    "frozen_source_required": {
      "type": "boolean"
    }
  }
}
