<?xml version="1.0" encoding="utf-8"?>
<!--
  Native Android text. Wording follows docs/ui-text.md; the WebView UI is in
  apps/desktop/src/locales. Translations go in values-<tag>/strings.xml.
  This file replaces the strings.xml generated by `tauri android init`, so it
  must keep app_name.
-->
<resources>
    <string name="app_name" translatable="false">SirinVPN</string>

    <!-- Connection status, shared by the VPN notification and the Quick Settings tile.
         Match home.status in the WebView catalog. -->
    <string name="status_connected">Connected</string>
    <string name="status_connecting">Connecting…</string>
    <string name="status_reconnecting">Reconnecting…</string>
    <string name="status_interrupted">Connection interrupted</string>
    <string name="status_disconnected">Disconnected</string>
    <string name="status_unknown">Status unknown</string>

    <!-- Notification channels, shown in Android notification settings. -->
    <string name="notification_channel_vpn">VPN connection</string>
    <string name="notification_channel_vpn_description">Connection status and controls</string>
    <string name="notification_channel_maintenance">Server tasks</string>
    <string name="notification_channel_maintenance_description">Progress of server tasks you start</string>
    <string name="notification_channel_updates">App updates</string>
    <string name="notification_channel_updates_description">Requests to approve SirinVPN updates</string>

    <!-- Ongoing VPN notification. %1$s is the download rate and %2$s the upload rate. -->
    <string name="notification_status_connected_traffic">Connected · ↓ %1$s · ↑ %2$s</string>
    <string name="notification_status_waiting_for_network">Waiting for network</string>
    <string name="notification_status_failed">Couldn’t connect</string>
    <!-- Transfer rates. %1$s is a formatted number. -->
    <string name="notification_rate_bytes">%1$s B/s</string>
    <string name="notification_rate_kilobytes">%1$s KB/s</string>
    <string name="notification_rate_megabytes">%1$s MB/s</string>
    <string name="notification_rate_gigabytes">%1$s GB/s</string>
    <string name="notification_rate_terabytes">%1$s TB/s</string>
    <!-- Notification actions: 1–3 words, verb first. -->
    <string name="notification_action_vpn_settings">VPN settings</string>
    <string name="notification_action_disconnect">Disconnect</string>
    <string name="notification_action_stop_connecting">Stop connecting</string>
    <string name="notification_action_retry">Retry</string>
    <!-- Dismissible alert after a connection attempt fails. -->
    <string name="notification_failure_text">Couldn’t connect. Open SirinVPN to see why.</string>
    <string name="notification_maintenance_title">Server task in progress</string>
    <string name="notification_maintenance_text">Reopen SirinVPN to see the result.</string>
    <string name="notification_update_title">Approve SirinVPN update</string>
    <string name="notification_update_text">Tap to review and install the verified update.</string>
    <string name="notification_test_text">Notifications are working.</string>

    <!-- Quick Settings tile. Subtitles are short; the tile shows about 15 characters. -->
    <string name="tile_status_always_on">Always-on VPN</string>
    <string name="tile_status_no_network">No network</string>
    <string name="tile_status_open_app">Open SirinVPN</string>
    <!-- Spoken description of the tile. %1$s is its status, for example “Connected”. -->
    <string name="tile_description">SirinVPN, %1$s</string>
    <!-- Shown on Android 12 and older, which can’t add the tile from the app. -->
    <string name="tile_add_instructions">Open Quick Settings, tap Edit and add SirinVPN.</string>

    <!-- Home-screen widget. Its button reuses the notification action labels. -->
    <string name="widget_description">Connection status with a Connect and Disconnect button</string>
    <string name="widget_no_server">Choose a Quick Settings server</string>
    <string name="widget_action_connect">Connect</string>
    <string name="widget_action_open">Open</string>

    <!-- Permission an automation app (Tasker, Automate) asks for. Android shows the label
         as “Allow <app> to <label>?”, so it starts lowercase. -->
    <string name="automation_permission_label">connect and disconnect SirinVPN</string>
    <string name="automation_permission_description">Lets the app connect or disconnect SirinVPN and choose its Quick Settings server, without opening SirinVPN.</string>

    <!-- QR code scanner. -->
    <string name="scanner_title">Scan QR code</string>
    <string name="scanner_back">Back</string>
    <string name="scanner_guidance">Keep the whole code in view. Enlarge a dense code on the other screen and hold steady.</string>
    <string name="scanner_flashlight_on">Turn on flashlight</string>
    <string name="scanner_flashlight_off">Turn off flashlight</string>
    <string name="scanner_refocus">Refocus</string>
    <string name="scanner_refocused">Focus reset. Move closer or farther away, keeping the whole code in view.</string>
    <string name="scanner_camera_error">The camera isn’t available. Tap Refocus to try again, or go back and enter the code.</string>

    <!-- Protected value viewer and secure entry. -->
    <string name="protected_value_title">Protected value</string>
    <string name="protected_value_qr_description">Protected QR code</string>
    <string name="protected_value_close">Close</string>
    <string name="protected_value_copy">Copy for 1 minute</string>
    <!-- Clipboard label; some keyboards and clipboard previews show it. -->
    <string name="protected_value_clip_label">SirinVPN protected value</string>
    <string name="secret_input_use">Use value</string>
    <string name="secret_input_clear">Clear value</string>
    <plurals name="secret_input_minimum_length">
        <item quantity="one">Use at least %1$d character.</item>
        <item quantity="other">Use at least %1$d characters.</item>
    </plurals>

    <!-- Native confirmation dialog. -->
    <string name="dialog_confirm">Confirm</string>
    <string name="dialog_cancel">Cancel</string>

    <!-- App routing picker. Match connection.routing in the WebView catalog. -->
    <string name="routing_title">Choose apps</string>
    <string name="routing_mode_include">Only selected apps use the VPN</string>
    <string name="routing_mode_exclude">Selected apps bypass the VPN</string>
    <string name="routing_include_title">Apps using the VPN</string>
    <string name="routing_exclude_title">Apps bypassing the VPN</string>
    <!-- One app in the list: %1$s is its name, %2$s its package name. -->
    <string name="routing_app_row">%1$s\n%2$s</string>
    <string name="routing_use_selection">Use selection</string>

    <!-- Sharing an encrypted backup or recovery file. -->
    <string name="share_chooser_title">Share encrypted file</string>
    <string name="share_clip_label">Encrypted SirinVPN file</string>

    <!-- Shown instead of the app when the system WebView is too old. %1$d is the minimum version. -->
    <string name="webview_update_message">Update Android System WebView\n\nSirinVPN needs WebView %1$d or newer. Update it, then reopen SirinVPN.</string>
    <string name="webview_update_action">Open WebView settings</string>

    <!-- Errors shown in the app. What happened, then what to do. -->
    <string name="error_choose_document">Choose an encrypted file first.</string>
    <string name="error_service_unavailable">Couldn’t reach the VPN service. Try again.</string>
    <string name="error_service_interrupted">Lost contact with the VPN service. Check the status, then try again.</string>
    <string name="error_share_expired">This file can no longer be shared. Export it again, then share it.</string>
    <string name="error_share_failed">Couldn’t share the file. Try again.</string>
    <string name="error_install_permission">Allow SirinVPN to install unknown apps, then try the update again.</string>
    <string name="error_protected_value_unavailable">Couldn’t open the protected value. Try again.</string>
    <string name="error_protected_value_expired">This protected value expired. Enter or create it again.</string>
    <string name="error_protected_input">Couldn’t keep the protected value. Finish the current task, then try again.</string>
    <string name="error_entry_cancelled">Entry cancelled.</string>
    <string name="error_notifications_blocked">Notifications are blocked. Allow them for SirinVPN in Android settings, then try again.</string>
    <string name="error_camera_denied">Camera access wasn’t granted. You can enter the code securely instead.</string>
    <string name="error_scanner_open">The scanner is already open.</string>
    <string name="error_scan_cancelled">Scanning cancelled. You can enter the code securely instead.</string>
    <string name="error_code_too_large">This code is too large. Scan a SirinVPN code.</string>
    <string name="error_vpn_permission_denied">VPN permission wasn’t granted. Connect again and allow it.</string>
    <string name="error_vpn_permission_required">VPN permission is needed. Connect again to allow it.</string>
    <string name="error_vpn_start_failed">Android couldn’t start the VPN. Try connecting again.</string>
    <string name="error_vpn_recovery_deferred">Android delayed restoring the VPN. Connect again.</string>
    <string name="error_always_on">Always-on VPN controls this connection. Change it in Android VPN settings.</string>
    <string name="error_connection_changed">The connection changed. Check its status, then try again.</string>
    <string name="error_busy_disconnect">Another task is in progress. Disconnect after it finishes.</string>
    <string name="error_busy">Another task is in progress. Try again when it finishes.</string>
    <string name="error_switching_method">Switching connection method. Try again in a moment.</string>
    <string name="error_queue_full">Too many requests are waiting. Try again when the current one finishes.</string>
    <string name="error_request_too_large">This request is too large. Shorten it and try again.</string>
    <string name="error_preferences">Couldn’t read or save app settings. Try again.</string>
    <string name="error_server_task_background">Android blocked the server task. Keep SirinVPN open and try again.</string>
    <string name="error_server_task_interrupted">A server task didn’t finish. Check the server or file before trying again.</string>
    <string name="error_operation_failed">The request couldn’t finish. Check permissions, settings and your network, then try again.</string>
</resources>
