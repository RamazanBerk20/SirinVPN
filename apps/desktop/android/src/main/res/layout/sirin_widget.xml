<?xml version="1.0" encoding="utf-8"?>
<!-- Home-screen widget. Text is replaced by SirinWidget; never put a server address here. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_background"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:paddingStart="14dp"
    android:paddingEnd="10dp">
    <ImageView
        android:layout_width="24dp"
        android:layout_height="24dp"
        android:importantForAccessibility="no"
        android:src="@drawable/ic_sirin_vpn" />
    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="12dp"
        android:layout_marginEnd="8dp"
        android:layout_weight="1"
        android:orientation="vertical">
        <TextView
            android:id="@+id/widget_status"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:maxLines="1"
            android:text="@string/app_name"
            android:textColor="#F4F7FF"
            android:textSize="15sp"
            android:textStyle="bold" />
        <TextView
            android:id="@+id/widget_server"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:maxLines="1"
            android:text="@string/tile_status_open_app"
            android:textColor="#A8B8CE"
            android:textSize="13sp" />
    </LinearLayout>
    <Button
        android:id="@+id/widget_toggle"
        android:layout_width="wrap_content"
        android:layout_height="40dp"
        android:background="@drawable/widget_button"
        android:minWidth="64dp"
        android:paddingStart="14dp"
        android:paddingEnd="14dp"
        android:text="@string/widget_action_open"
        android:textAllCaps="false"
        android:textColor="#FFFFFF"
        android:textSize="14sp" />
</LinearLayout>
