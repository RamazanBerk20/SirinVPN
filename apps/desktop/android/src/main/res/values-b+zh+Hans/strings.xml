    <plurals name="secret_input_minimum_length">
        <item quantity="other">请至少使用 %1$d 个字符。</item>
    </plurals>

    <!-- Native confirmation dialog. -->
    <string name="dialog_confirm">确认</string>
    <string name="dialog_cancel">取消</string>

