<?xml version="1.0" encoding="utf-8"?>
<resources>

    <!-- Connection status, shared by the VPN notification and the Quick Settings tile.
         Match home.status in the WebView catalog. -->
    <string name="status_connected">已连接</string>
    <string name="status_connecting">正在连接…</string>
    <string name="status_reconnecting">正在重新连接…</string>
    <string name="status_interrupted">连接已中断</string>
    <string name="status_disconnected">已断开连接</string>
    <string name="status_unknown">状态未知</string>

    <!-- Notification channels, shown in Android notification settings. -->
    <string name="notification_channel_vpn">VPN 连接</string>
    <string name="notification_channel_vpn_description">连接状态和控制</string>
    <string name="notification_channel_maintenance">服务器任务</string>
