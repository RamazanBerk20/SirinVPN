    <string name="notification_action_vpn_settings">VPN 设置</string>
    <string name="notification_action_disconnect">断开连接</string>
    <string name="notification_action_stop_connecting">停止连接</string>
    <string name="notification_action_hide">隐藏通知</string>
    <string name="notification_action_retry">重试</string>
    <!-- Dismissible alert after a connection attempt fails. -->
    <string name="notification_failure_text">无法连接。请打开 SirinVPN 查看原因。</string>
    <string name="notification_maintenance_title">服务器任务进行中</string>
    <string name="notification_maintenance_text">重新打开 SirinVPN 查看结果。</string>
    <string name="notification_wifi_watch_text">自动连接正在监视不受信任的 Wi-Fi</string>
    <string name="notification_update_title">批准 SirinVPN 更新</string>
    <string name="notification_update_text">点按即可查看并安装已验证的更新。</string>
    <string name="notification_test_text">通知工作正常。</string>

    <!-- Quick Settings tile. Subtitles are short; the tile shows about 15 characters. -->
    <string name="tile_status_always_on">始终开启的 VPN</string>
    <string name="tile_status_no_network">无网络</string>
    <string name="tile_status_open_app">打开 SirinVPN</string>
    <!-- Spoken description of the tile. %1$s is its status, for example “Connected”. -->
    <string name="tile_description">SirinVPN，%1$s</string>
    <!-- Shown on Android 12 and older, which can’t add the tile from the app. -->
    <string name="tile_add_instructions">打开快速设置，点按“编辑”，然后添加 SirinVPN。</string>

    <!-- Home-screen widget. Its button reuses the notification action labels. -->
    <string name="widget_description">显示连接状态，并带有“连接”和“断开连接”按钮</string>
    <string name="widget_no_server">请选择快速设置服务器</string>
    <string name="widget_action_connect">连接</string>
    <string name="widget_action_open">打开</string>

    <!-- Permission an automation app (Tasker, Automate) asks for. Android shows the label
         as “Allow <app> to <label>?”, so it starts lowercase. -->
    <string name="automation_permission_label">连接和断开 SirinVPN</string>
    <string name="automation_permission_description">允许该应用连接或断开 SirinVPN，并选择其快速设置服务器，无需打开 SirinVPN。</string>

    <!-- QR code scanner. -->
    <string name="scanner_title">扫描二维码</string>
    <string name="scanner_back">返回</string>
    <string name="scanner_guidance">请让整个代码保持在画面内。如果代码较密集，请在另一屏幕上将其放大，并保持手机稳定。</string>
