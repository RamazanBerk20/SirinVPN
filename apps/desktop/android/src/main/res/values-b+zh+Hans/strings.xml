    <string name="notification_rate_bytes">%1$s B/秒</string>
    <string name="notification_rate_kilobytes">%1$s KB/秒</string>
    <string name="notification_rate_megabytes">%1$s MB/秒</string>
    <string name="notification_rate_gigabytes">%1$s GB/秒</string>
    <string name="notification_rate_terabytes">%1$s TB/秒</string>
