<?xml version="1.0" encoding="utf-8"?>
<!--
  Native Android text. Wording follows docs/ui-text.md; the WebView UI is in
  apps/desktop/src/locales. Translations go in values-<tag>/strings.xml.
  This file replaces the strings.xml generated by `tauri android init`, so it
  must keep app_name.
-->
<resources>
    <!-- Connection status, shared by the VPN notification and the Quick Settings tile.
         Match home.status in the WebView catalog. -->
    <string name="status_connected">Подключено</string>
    <string name="status_connecting">Подключение…</string>
    <string name="status_reconnecting">Переподключение…</string>
    <string name="status_interrupted">Подключение прервано</string>
    <string name="status_disconnected">Отключено</string>
    <string name="status_unknown">Состояние неизвестно</string>

    <!-- Notification channels, shown in Android notification settings. -->
    <string name="notification_channel_vpn">Подключение VPN</string>
    <string name="notification_channel_vpn_description">Состояние подключения и управление</string>
    <string name="notification_channel_maintenance">Задачи сервера</string>
    <string name="notification_channel_maintenance_description">Ход задач сервера, которые вы запустили</string>
    <string name="notification_channel_updates">Обновления приложения</string>
    <string name="notification_channel_updates_description">Запросы на подтверждение обновлений SirinVPN</string>
    <string name="notification_channel_wifi">Автоподключение по Wi-Fi</string>
    <string name="notification_channel_wifi_description">Показывается, пока автоподключение следит за недоверенным Wi-Fi при выключенном VPN. Выключение этого уведомления не останавливает автоподключение.</string>

    <!-- Ongoing VPN notification. %1$s is the download rate and %2$s the upload rate. -->
    <string name="notification_status_connected_traffic">Подключено · ↓ %1$s · ↑ %2$s</string>
    <string name="notification_status_waiting_for_network">Ожидание сети</string>
    <string name="notification_status_failed">Не удалось подключиться</string>
    <!-- Transfer rates. %1$s is a formatted number. -->
    <string name="notification_rate_bytes">%1$s Б/с</string>
    <string name="notification_rate_kilobytes">%1$s КБ/с</string>
    <string name="notification_rate_megabytes">%1$s МБ/с</string>
    <string name="notification_rate_gigabytes">%1$s ГБ/с</string>
    <string name="notification_rate_terabytes">%1$s ТБ/с</string>
    <!-- Notification actions: 1–3 words, verb first. -->
    <string name="notification_action_vpn_settings">Настройки VPN</string>
    <string name="notification_action_disconnect">Отключиться</string>
    <string name="notification_action_stop_connecting">Остановить подключение</string>
    <string name="notification_action_hide">Скрыть уведомление</string>
    <string name="notification_action_retry">Повторить</string>
    <!-- Dismissible alert after a connection attempt fails. -->
    <string name="notification_failure_text">Не удалось подключиться. Откройте SirinVPN, чтобы узнать причину.</string>
    <string name="notification_maintenance_title">Задача сервера выполняется</string>
    <string name="notification_maintenance_text">Откройте SirinVPN снова, чтобы увидеть результат.</string>
    <string name="notification_wifi_watch_text">Автоподключение следит за недоверенным Wi-Fi</string>
    <string name="notification_update_title">Подтвердите обновление SirinVPN</string>
    <string name="notification_update_text">Нажмите, чтобы проверить и установить проверенное обновление.</string>
    <string name="notification_test_text">Уведомления работают.</string>

    <!-- Quick Settings tile. Subtitles are short; the tile shows about 15 characters. -->
    <string name="tile_status_always_on">Постоянный VPN</string>
    <string name="tile_status_no_network">Нет сети</string>
    <string name="tile_status_open_app">Открыть SirinVPN</string>
    <!-- Spoken description of the tile. %1$s is its status, for example «Подключено». -->
    <string name="tile_description">SirinVPN, %1$s</string>
    <!-- Shown on Android 12 and older, which can’t add the tile from the app. -->
    <string name="tile_add_instructions">Откройте «Быстрые настройки», нажмите «Изменить» и добавьте SirinVPN.</string>

    <!-- Home-screen widget. Its button reuses the notification action labels. -->
    <string name="widget_description">Состояние подключения с кнопками «Подключиться» и «Отключиться»</string>
    <string name="widget_no_server">Выберите сервер для быстрых настроек</string>
    <string name="widget_action_connect">Подключиться</string>
    <string name="widget_action_open">Открыть</string>

    <!-- Permission an automation app (Tasker, Automate) asks for. Android shows the label
         as “Allow <app> to <label>?”, so it starts lowercase. -->
    <string name="automation_permission_label">подключать и отключать SirinVPN</string>
    <string name="automation_permission_description">Позволяет приложению подключать или отключать SirinVPN и выбирать его сервер для быстрых настроек, не открывая SirinVPN.</string>

    <!-- QR code scanner. -->
    <string name="scanner_title">Сканировать QR-код</string>
    <string name="scanner_back">Назад</string>
    <string name="scanner_guidance">Держите весь код в кадре. Увеличьте плотный код на другом экране и держите устройство неподвижно.</string>
    <string name="scanner_flashlight_on">Включить фонарик</string>
    <string name="scanner_flashlight_off">Выключить фонарик</string>
    <string name="scanner_refocus">Сфокусировать заново</string>
    <string name="scanner_refocused">Фокус сброшен. Приблизьте или отдалите камеру, держа весь код в кадре.</string>
    <string name="scanner_camera_error">Камера недоступна. Нажмите «Сфокусировать заново», чтобы повторить попытку, или вернитесь и введите код.</string>

    <!-- Protected value viewer and secure entry. -->
    <string name="protected_value_title">Защищённое значение</string>
    <string name="protected_value_qr_description">Защищённый QR-код</string>
    <string name="protected_value_close">Закрыть</string>
    <string name="protected_value_copy">Копировать на 1 минуту</string>
    <string name="protected_value_show">Показать</string>
    <string name="protected_value_confirm_show">Показать это защищённое значение на экране?</string>
    <string name="protected_value_confirm_copy">Скопировать это защищённое значение в буфер обмена на 1 минуту?</string>
    <!-- Clipboard label; some keyboards and clipboard previews show it. -->
    <string name="protected_value_clip_label">Защищённое значение SirinVPN</string>
    <string name="secret_input_use">Использовать значение</string>
    <string name="secret_input_clear">Очистить значение</string>
    <plurals name="secret_input_minimum_length">
        <item quantity="one">Используйте не менее %1$d символа.</item>
        <item quantity="few">Используйте не менее %1$d символов.</item>
        <item quantity="many">Используйте не менее %1$d символов.</item>
        <item quantity="other">Используйте не менее %1$d символа.</item>
    </plurals>

    <!-- Native confirmation dialog. -->
    <string name="dialog_confirm">Подтвердить</string>
    <string name="dialog_cancel">Отмена</string>

    <!-- App routing picker. Match connection.routing in the WebView catalog. -->
    <string name="routing_title">Выберите приложения</string>
    <string name="routing_mode_include">Через VPN работают только выбранные приложения</string>
    <string name="routing_mode_exclude">Выбранные приложения обходят VPN</string>
    <string name="routing_include_title">Приложения, которые используют VPN</string>
    <string name="routing_exclude_title">Приложения, которые обходят VPN</string>
    <string name="routing_use_selection">Использовать выбор</string>

    <!-- Sharing an encrypted backup or recovery file. -->
    <string name="share_chooser_title">Поделиться зашифрованным файлом</string>
    <string name="share_clip_label">Зашифрованный файл SirinVPN</string>

    <!-- Shown instead of the app when the system WebView is too old. %1$d is the minimum version. -->
    <string name="webview_update_message">Обновите системный WebView Android\n\nSirinVPN нужен WebView версии %1$d или новее. Обновите его, затем снова откройте SirinVPN.</string>
    <string name="webview_update_action">Открыть настройки WebView</string>

    <!-- Errors shown in the app. What happened, then what to do. -->
    <string name="error_choose_document">Сначала выберите зашифрованный файл.</string>
    <string name="error_service_unavailable">Не удалось связаться со службой VPN. Повторите попытку.</string>
    <string name="error_service_interrupted">Связь со службой VPN потеряна. Проверьте состояние и повторите попытку.</string>
    <string name="error_share_expired">Этот файл больше нельзя передать. Экспортируйте его заново и поделитесь им.</string>
    <string name="error_share_failed">Не удалось передать файл. Повторите попытку.</string>
    <string name="error_install_permission">Разрешите SirinVPN установку неизвестных приложений, затем повторите обновление.</string>
    <string name="error_protected_value_unavailable">Не удалось открыть защищённое значение. Повторите попытку.</string>
    <string name="error_protected_value_expired">Срок действия этого защищённого значения истёк. Введите или создайте его заново.</string>
    <string name="error_protected_input">Не удалось сохранить защищённое значение. Завершите текущую задачу и повторите попытку.</string>
    <string name="error_entry_cancelled">Ввод отменён.</string>
    <string name="error_notifications_blocked">Уведомления заблокированы. Разрешите их для SirinVPN в настройках Android, затем повторите попытку.</string>
    <string name="error_camera_denied">Доступ к камере не предоставлен. Вы можете ввести код безопасно.</string>
    <string name="error_scanner_open">Сканер уже открыт.</string>
    <string name="error_scan_cancelled">Сканирование отменено. Вы можете ввести код безопасно.</string>
    <string name="error_code_too_large">Этот код слишком большой. Отсканируйте код SirinVPN.</string>
    <string name="error_vpn_permission_denied">Разрешение на VPN не предоставлено. Подключитесь снова и разрешите его.</string>
    <string name="error_vpn_permission_required">Нужно разрешение на VPN. Подключитесь снова, чтобы его выдать.</string>
    <string name="error_vpn_start_failed">Android не смог запустить VPN. Попробуйте подключиться снова.</string>
    <string name="error_vpn_recovery_deferred">Android отложил восстановление VPN. Подключитесь снова.</string>
    <string name="error_always_on">Этим подключением управляет постоянный VPN. Измените это в настройках VPN Android.</string>
    <string name="error_connection_changed">Подключение изменилось. Проверьте его состояние и повторите попытку.</string>
    <string name="error_busy_disconnect">Выполняется другая задача. Отключитесь после её завершения.</string>
    <string name="error_busy">Выполняется другая задача. Повторите попытку после её завершения.</string>
    <string name="error_switching_method">Идёт смена способа подключения. Повторите попытку через минуту.</string>
    <string name="error_queue_full">Слишком много запросов ждут. Повторите попытку, когда текущий завершится.</string>
    <string name="error_request_too_large">Этот запрос слишком большой. Сократите его и повторите попытку.</string>
    <string name="error_preferences">Не удалось прочитать или сохранить настройки приложения. Повторите попытку.</string>
    <string name="error_server_task_background">Android заблокировал задачу сервера. Не закрывайте SirinVPN и повторите попытку.</string>
    <string name="error_server_task_interrupted">Задача сервера не завершилась. Проверьте сервер или файл, прежде чем повторить попытку.</string>
    <string name="error_missing_command">Запрос был неполным. Обновите SirinVPN, затем повторите попытку.</string>
    <string name="error_native_only">Это действие доступно только в защищённых диалогах SirinVPN.</string>
    <string name="error_operation_failed">Запрос не удалось выполнить. Проверьте разрешения, настройки и сеть, затем повторите попытку.</string>
</resources>
