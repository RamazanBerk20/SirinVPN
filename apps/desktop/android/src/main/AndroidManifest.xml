<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android" xmlns:tools="http://schemas.android.com/tools">
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <!-- Direct APK distribution: enumerate packages only in the explicit VPN routing picker. -->
    <uses-permission android:name="android.permission.QUERY_ALL_PACKAGES" tools:ignore="QueryAllPackagesPermission" />
    <uses-permission android:name="android.permission.REQUEST_INSTALL_PACKAGES" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_SYSTEM_EXEMPTED" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_DATA_SYNC" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.CAMERA" />
    <uses-permission android:name="android.permission.WAKE_LOCK" tools:node="remove" />
    <uses-permission android:name="android.permission.VIBRATE" tools:node="remove" />
    <uses-feature android:name="android.hardware.camera" android:required="false" />
    <!-- CAMERA implies autofocus. Android TV has neither a camera nor a touchscreen. -->
    <uses-feature android:name="android.hardware.camera.autofocus" android:required="false" />
    <uses-feature android:name="android.hardware.touchscreen" android:required="false" />
    <uses-feature android:name="android.software.leanback" android:required="false" />
    <!-- Granted by the user to an automation app; see docs/android/automation.md. -->
    <permission android:name="org.sirinvpn.permission.CONTROL_VPN" android:protectionLevel="dangerous"
        android:label="@string/automation_permission_label" android:description="@string/automation_permission_description" />
    <queries><intent><action android:name="android.intent.action.MAIN" /><category android:name="android.intent.category.LAUNCHER" /></intent></queries>
    <application android:icon="@mipmap/ic_launcher" android:label="@string/app_name" android:banner="@drawable/tv_banner"
        android:theme="@style/Theme.sirinvpn_desktop" android:allowBackup="false"
        android:fullBackupContent="@xml/backup_rules" android:dataExtractionRules="@xml/data_extraction_rules"
        android:usesCleartextTraffic="false" android:enableOnBackInvokedCallback="true">
        <activity android:name=".MainActivity" android:exported="true" android:launchMode="singleTask"
            android:windowSoftInputMode="adjustResize"
            android:configChanges="orientation|keyboardHidden|keyboard|screenSize|locale|smallestScreenSize|screenLayout|uiMode|fontScale|density">
            <intent-filter><action android:name="android.intent.action.MAIN" /><category android:name="android.intent.category.LAUNCHER" /><category android:name="android.intent.category.LEANBACK_LAUNCHER" /></intent-filter>
            <intent-filter><action android:name="android.service.quicksettings.action.QS_TILE_PREFERENCES" /><category android:name="android.intent.category.DEFAULT" /></intent-filter>
        </activity>
        <activity android:name=".ControlActionActivity" android:exported="false" android:excludeFromRecents="true" />
        <service android:name=".ControlService" android:process=":vpn" android:exported="false" />
        <service android:name=".MaintenanceService" android:process=":vpn" android:exported="false" android:stopWithTask="false" android:foregroundServiceType="dataSync" />
        <service android:name=".SirinVpnService" android:process=":vpn" android:exported="true"
            android:permission="android.permission.BIND_VPN_SERVICE" android:stopWithTask="false"
            android:foregroundServiceType="systemExempted" tools:ignore="ForegroundServicePermission">
            <!-- A user-authorized VPN is a documented exemption. No alarm permission is used. -->
            <intent-filter><action android:name="android.net.VpnService" /></intent-filter>
        </service>
        <service android:name=".SirinTileService" android:exported="true" android:permission="android.permission.BIND_QUICK_SETTINGS_TILE"
            android:label="@string/app_name" android:icon="@drawable/ic_sirin_vpn">
            <intent-filter><action android:name="android.service.quicksettings.action.QS_TILE" /></intent-filter>
            <meta-data android:name="android.service.quicksettings.ACTIVE_TILE" android:value="true" />
            <meta-data android:name="android.service.quicksettings.TOGGLEABLE_TILE" android:value="true" />
        </service>
        <receiver android:name=".VpnActionReceiver" android:exported="false" />
        <receiver android:name=".AutomationReceiver" android:exported="true" android:permission="org.sirinvpn.permission.CONTROL_VPN">
            <intent-filter>
                <action android:name="org.sirinvpn.action.CONNECT" />
                <action android:name="org.sirinvpn.action.DISCONNECT" />
                <action android:name="org.sirinvpn.action.SELECT_SERVER" />
            </intent-filter>
        </receiver>
        <!-- Rendered by the :vpn controller; home_screen only, never on the lock screen. -->
        <receiver android:name=".SirinWidget" android:process=":vpn" android:exported="false" android:label="@string/app_name">
            <intent-filter><action android:name="android.appwidget.action.APPWIDGET_UPDATE" /></intent-filter>
            <meta-data android:name="android.appwidget.provider" android:resource="@xml/sirin_widget_info" />
        </receiver>
        <receiver android:name=".ApkInstallResult" android:exported="false" android:process=":vpn" />
        <receiver android:name=".ReplacementReceiver" android:exported="false" android:process=":vpn">
            <intent-filter><action android:name="android.intent.action.MY_PACKAGE_REPLACED" /></intent-filter>
        </receiver>
        <activity android:name="com.journeyapps.barcodescanner.CaptureActivity" tools:node="remove" />
    </application>
</manifest>
